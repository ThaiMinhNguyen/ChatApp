<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="40dp"
        android:background="@drawable/bg_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            >

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lato_bold"
                android:text="Tin nhắn"
                android:textColor="@android:color/white"
                android:textSize="30sp" />

            <ImageView
                android:id="@+id/ivCreateNewChat"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_circle_image"
                android:contentDescription="Search"
                android:padding="5dp"
                android:src="@drawable/ic_create_new_chat"
                app:tint="@color/primary_blue"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            >

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/primary_blue"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="#E0E0E0"
                app:boxCornerRadiusBottomEnd="30dp"
                app:boxCornerRadiusBottomStart="30dp"
                app:boxCornerRadiusTopEnd="30dp"
                app:boxCornerRadiusTopStart="30dp"
               >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_regular"
                    android:inputType="text"
                    android:hint="Tìm kiếm tin nhắn..."
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:text="Hủy"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:fontFamily="@font/lato_regular"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible"/>

        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvChatList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/CustomCardViewStyle"
        android:layout_marginTop="-20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llHeader">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="35dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:background="@android:color/transparent"
            tools:listitem="@layout/item_chat" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIN NHẮN"
        android:fontFamily="@font/lato_bold"
        android:textColor="@color/icon_dark_gray"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@+id/cvChatList"
        app:layout_constraintTop_toTopOf="@+id/cvChatList"
        android:paddingVertical="15dp"
        android:paddingHorizontal="20dp"
        android:visibility="gone"
        tools:visibility="visible"
        />

    <LinearLayout
        android:id="@+id/llNoSearchResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cvChatList"
        app:layout_constraintStart_toStartOf="@id/cvChatList"
        app:layout_constraintBottom_toBottomOf="@id/cvChatList"
        android:paddingTop="90dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search_not_found"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không tìm thấy kết quả phù hợp"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/lato_bold"
            android:paddingTop="10dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 