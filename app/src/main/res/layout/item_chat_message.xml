<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <TextView
        android:id="@+id/tvDateSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_date_separator"
        android:fontFamily="@font/lato_regular"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        tools:text="Hôm nay"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/llReceivedMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="80dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDateSeparator"
        tools:visibility="visible">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/civSenderAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_user_mail"
            app:civ_border_color="#E0E0E0"
            app:civ_border_width="1dp"
            tools:src="@drawable/ic_user_mail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReceivedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_received_message"
                android:fontFamily="@font/lato_regular"
                android:maxWidth="280dp"
                android:padding="12dp"
                tools:text="Làm xong bài tập thầy Hoàng giao chưa??"
                android:textColor="#333333"
                android:textSize="16sp"
                tools:visibility="visible"
                />

            <ImageView
                android:id="@+id/ivReceivedImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxWidth="500dp"
                android:maxHeight="500dp"
                android:minWidth="150dp"
                android:minHeight="150dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_received_message"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:visibility="visible"
                tools:src="@drawable/profile_preview" />

            <TextView
                android:id="@+id/tvReceivedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/lato_regular"
                tools:text="10:03"
                android:visibility="gone"
                tools:visibility="visible"
                android:textColor="#999999"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSentMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDateSeparator"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvSentMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sent_message"
            android:fontFamily="@font/lato_regular"
            android:maxWidth="280dp"
            android:padding="12dp"
            tools:text="Ko biết làm. Tí tôi qua nhà bà chép..."
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/ivSentImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="500dp"
            android:maxHeight="500dp"
            android:minWidth="150dp"
            android:minHeight="150dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_sent_message"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:visibility="visible"
            tools:src="@drawable/profile_preview" />

        <TextView
            android:id="@+id/tvSentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lato_regular"
            android:gravity="end"
            android:text="@string/sending"
            tools:text="10:05"
            android:textColor="#999999"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>